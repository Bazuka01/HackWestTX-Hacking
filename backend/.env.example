# Copy this file to backend/.env and fill in the values.
# backend/.env is gitignored and must never be committed.
# The db/ scripts read this file too.

# TigerData Postgres connection string
TIGER_DATA_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Gemini API key
GEMINI_API_KEY=

# Random secret shared with web/.env.local, so only the Next.js server can
# call the /users/me endpoints. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=
