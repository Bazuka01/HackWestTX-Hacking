# Auth0 (https://manage.auth0.com)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Backend API, called from the Next.js server (never from the browser)
BACKEND_URL=http://localhost:8000
# Must match INTERNAL_API_KEY in backend/.env
INTERNAL_API_KEY=
